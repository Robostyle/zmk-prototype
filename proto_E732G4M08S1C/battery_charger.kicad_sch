	(text_box "TMR: t = 10 * R_{tmr} * K_{tmr}, k_{trm_typ} = 48 s/kΩ, t = 6.25h, R_{tmr} = (6.25h * 3600 s/hr) / (10 * 48 s/kΩ) = 46.8 kΩ = 47 kΩ\nILIM: R_{ILIM} = K_{ILIM} / I_{I_MAX} = 1610 AΩ / 1.2A = 1341.66Ω = ~1330Ω; ILIM = 1610 / 1330Ω = 1210 mA\nISET: R_{ISET} = K_{ISET} / I_{CHG} = \n        890 AΩ / 0.8 A = 1112 Ω = 1130 Ω\n        890 AΩ / 0.5 A = 1780 Ω = 1780 Ω\n        890 AΩ / 0.1 A = 8900 Ω = 8870 Ω"
		(exclude_from_sim no)
		(at 35.56 34.29 0)
